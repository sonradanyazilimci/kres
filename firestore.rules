rules_version = '2';

// =============================================================
//  Anaokul 360 — Cok-Kiracili Firestore Guvenlik Kurallari
//  /kullaniciDizini/{uid}   -> { kresId, rol }
//  /kresler/{kresId}        -> ayarlar + abonelik
//  /kresler/{kresId}/<alt>  -> kres verisi
//  /superAdmins/{uid}       -> saglayici (siz)
// =============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Yardimcilar ----------
    function girisli() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function superAdmin() {
      return girisli() && exists(/databases/$(database)/documents/superAdmins/$(uid()));
    }
    function dizin() {
      return get(/databases/$(database)/documents/kullaniciDizini/$(uid())).data;
    }
    function benimKres() {
      return girisli()
        && exists(/databases/$(database)/documents/kullaniciDizini/$(uid()))
        ? dizin().kresId : "";
    }
    function benimRol() {
      return exists(/databases/$(database)/documents/kullaniciDizini/$(uid()))
        ? dizin().rol : "";
    }
    function uyesi(kid) { return girisli() && benimKres() == kid; }
    function kadmin(kid) { return uyesi(kid) && benimRol() == 'admin'; }
    function kogretmen(kid) { return uyesi(kid) && benimRol() == 'ogretmen'; }

    function kres(kid) {
      return get(/databases/$(database)/documents/kresler/$(kid)).data;
    }
    function kresBitis(kid) {
      return kres(kid).get('bitisTarihi', null);
    }
    function kresAktif(kid) {
      return kres(kid).durum == 'aktif'
        && (kresBitis(kid) == null || kresBitis(kid) > request.time);
    }
    // Yazma izni: super-admin her zaman; kres uyesi ancak kres aktifse.
    function yazabilir(kid) { return superAdmin() || kresAktif(kid); }

    function sinifOgretmeni(kid, sinifId) {
      return get(/databases/$(database)/documents/kresler/$(kid)/siniflar/$(sinifId)).data.ogretmenId == uid();
    }
    function ogrenciVelisi(kid, ogrenciId) {
      return uid() in get(/databases/$(database)/documents/kresler/$(kid)/ogrenciler/$(ogrenciId)).data.veliIds;
    }

    // Super-admin tum sistemi OKUYABILIR (kok koleksiyonlar dahil).
    // Yazma yetkileri asagida her koleksiyonda ayrica tanimli.
    match /{yol=**} {
      allow read: if superAdmin();
    }

    // =========================================================
    //  Site icerigi (anasayfa metinleri) — herkese acik okuma
    // =========================================================
    match /site/{belge} {
      allow read: if true;                  // giris yapmamis ziyaretci de okur
      allow write: if superAdmin();
    }

    // =========================================================
    //  Sistem duyurulari (saglayici -> tum kresler, herkese acik)
    // =========================================================
    match /sistemDuyurulari/{id} {
      allow read: if true;
      allow write: if superAdmin();
    }

    // =========================================================
    //  Saglayici
    // =========================================================
    match /superAdmins/{u} {
      allow read: if girisli() && (uid() == u || superAdmin());
      allow create: if superAdmin();          // ilk kayit Firebase Console'dan
      allow update, delete: if superAdmin();
    }

    // =========================================================
    //  Kullanici dizini
    // =========================================================
    match /kullaniciDizini/{u} {
      allow read: if girisli() && (uid() == u || superAdmin() || kadmin(resource.data.kresId));
      // Super-admin her zaman; kres sahibi self-signup (rol=admin, o kresin sahibi);
      // ya da hedef kresin yoneticisi personel ekliyor.
      allow create: if superAdmin() || (girisli() && (
        (uid() == u
          && request.resource.data.rol == 'admin'
          && kres(request.resource.data.kresId).sahibiUid == uid())
        || kadmin(request.resource.data.kresId)
      ) && request.resource.data.rol in ['admin', 'ogretmen', 'veli']);
      allow update: if superAdmin() || (
        kadmin(resource.data.kresId)
        && uid() != u
        && request.resource.data.kresId == resource.data.kresId
        && request.resource.data.rol in ['admin', 'ogretmen', 'veli']
      );
      allow delete: if superAdmin() || (kadmin(resource.data.kresId) && uid() != u);
    }

    // =========================================================
    //  Kres dokumani
    // =========================================================
    match /kresler/{kid} {
      allow read: if uyesi(kid) || superAdmin();
      // Super-admin serbest; self-signup: sahibi kendisi, ONAY BEKLEYEN başvuru.
      allow create: if superAdmin() || (girisli()
        && request.resource.data.sahibiUid == uid()
        && request.resource.data.durum == 'onayBekliyor'
        && request.resource.data.plan == 'deneme');
      // Yonetici yalnizca ayar alanlarini degistirebilir; abonelik alanlari sabit.
      allow update: if superAdmin() || (
        kadmin(kid)
        && request.resource.data.durum == resource.data.durum
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.get('bitisTarihi', null) == resource.data.get('bitisTarihi', null)
        && request.resource.data.sahibiUid == resource.data.sahibiUid
      );
      allow delete: if superAdmin();

      // -----------------------------------------------------
      //  users (kres personeli + veliler)
      // -----------------------------------------------------
      match /users/{u} {
        allow read: if uyesi(kid) || superAdmin();
        allow create: if superAdmin()
          || (uid() == u && kres(kid).sahibiUid == uid())        // self-signup admin
          || (kadmin(kid) && yazabilir(kid));                    // personel ekleme
        allow update: if superAdmin()
          || (kadmin(kid) && yazabilir(kid))
          || (uid() == u && request.resource.data.rol == resource.data.rol); // kendi profili/rizasi
        allow delete: if superAdmin() || (kadmin(kid) && yazabilir(kid));
      }

      // -----------------------------------------------------
      //  siniflar
      // -----------------------------------------------------
      match /siniflar/{id} {
        allow read: if uyesi(kid) || superAdmin();
        allow write: if (superAdmin() || kadmin(kid)) && yazabilir(kid);
      }

      // -----------------------------------------------------
      //  ogrenciler
      // -----------------------------------------------------
      match /ogrenciler/{id} {
        allow read: if superAdmin() || kadmin(kid)
          || (kogretmen(kid) && sinifOgretmeni(kid, resource.data.sinifId))
          || (uyesi(kid) && uid() in resource.data.veliIds);
        allow write: if (superAdmin() || kadmin(kid)) && yazabilir(kid);
      }

      // -----------------------------------------------------
      //  yoklamalar
      // -----------------------------------------------------
      match /yoklamalar/{id} {
        allow read: if superAdmin() || kadmin(kid)
          || (kogretmen(kid) && sinifOgretmeni(kid, resource.data.sinifId))
          || ogrenciVelisi(kid, resource.data.ogrenciId);
        allow create, update: if yazabilir(kid) && (superAdmin() || kadmin(kid)
          || (kogretmen(kid) && sinifOgretmeni(kid, request.resource.data.sinifId)
              && request.resource.data.ogretmenId == uid()));
        allow delete: if (superAdmin() || kadmin(kid)) && yazabilir(kid);
      }

      // -----------------------------------------------------
      //  gunlukRaporlar
      // -----------------------------------------------------
      match /gunlukRaporlar/{id} {
        allow read: if superAdmin() || kadmin(kid)
          || (kogretmen(kid) && sinifOgretmeni(kid, resource.data.sinifId))
          || ogrenciVelisi(kid, resource.data.ogrenciId);
        allow create, update: if yazabilir(kid) && (superAdmin() || kadmin(kid)
          || (kogretmen(kid) && sinifOgretmeni(kid, request.resource.data.sinifId)
              && request.resource.data.ogretmenId == uid()));
        allow delete: if (superAdmin() || kadmin(kid)) && yazabilir(kid);
      }

      // -----------------------------------------------------
      //  bildirimler (uygulama ici bildirim merkezi)
      //  Her belge tek bir kullaniciya hedeflenir (hedefUid).
      // -----------------------------------------------------
      match /bildirimler/{id} {
        allow read: if superAdmin()
          || (uyesi(kid) && resource.data.hedefUid == uid());
        // Herhangi bir kres uyesi baska bir uyeye bildirim yazabilir
        // (ogretmen -> veli, veli -> yonetici vb.)
        allow create: if superAdmin() || (uyesi(kid)
          && request.resource.data.hedefUid is string);
        // Yalnizca alicisi "okundu" isaretler; hedef degistirilemez.
        allow update: if superAdmin() || (uyesi(kid)
          && resource.data.hedefUid == uid()
          && request.resource.data.hedefUid == resource.data.hedefUid);
        allow delete: if superAdmin()
          || (uyesi(kid) && resource.data.hedefUid == uid());
      }

      // -----------------------------------------------------
      //  devamsizlikBildirimleri (veli -> ogretmen: gelmeyecek / gec)
      // -----------------------------------------------------
      match /devamsizlikBildirimleri/{id} {
        allow read: if superAdmin() || kadmin(kid)
          || (kogretmen(kid) && sinifOgretmeni(kid, resource.data.sinifId))
          || (uyesi(kid) && resource.data.veliUid == uid());
        allow create: if yazabilir(kid) && uyesi(kid)
          && request.resource.data.veliUid == uid()
          && ogrenciVelisi(kid, request.resource.data.ogrenciId)
          && request.resource.data.tur in ['gelmeyecek', 'gec'];
        allow update: if false;
        allow delete: if superAdmin() || kadmin(kid)
          || (uyesi(kid) && resource.data.veliUid == uid());
      }

      // -----------------------------------------------------
      //  menuler (haftalik yemek listesi — okul geneli)
      //  Dokuman kimligi: hafta baslangic tarihi (YYYY-MM-DD, Pazartesi)
      // -----------------------------------------------------
      match /menuler/{hafta} {
        allow read: if uyesi(kid) || superAdmin();
        allow write: if (superAdmin() || kadmin(kid)) && yazabilir(kid);
      }

      // -----------------------------------------------------
      //  programlar (haftalik sinif etkinlik programi)
      //  Dokuman kimligi: {sinifId}_{haftaBaslangic}
      // -----------------------------------------------------
      match /programlar/{id} {
        allow read: if uyesi(kid) || superAdmin();
        allow create, update: if yazabilir(kid) && (superAdmin() || kadmin(kid)
          || (kogretmen(kid) && sinifOgretmeni(kid, request.resource.data.sinifId)));
        allow delete: if (superAdmin() || kadmin(kid)) && yazabilir(kid);
      }

      // -----------------------------------------------------
      //  gozlemler (ogretmen ic gozlem gunlugu — veliye KAPALI)
      // -----------------------------------------------------
      match /gozlemler/{id} {
        allow read: if superAdmin() || kadmin(kid)
          || (kogretmen(kid) && sinifOgretmeni(kid, resource.data.sinifId));
        allow create: if yazabilir(kid) && (kadmin(kid)
          || (kogretmen(kid) && sinifOgretmeni(kid, request.resource.data.sinifId)
              && request.resource.data.ogretmenId == uid()));
        allow update, delete: if yazabilir(kid)
          && (kadmin(kid) || resource.data.ogretmenId == uid());
      }

      // -----------------------------------------------------
      //  duyurular
      // -----------------------------------------------------
      match /duyurular/{id} {
        allow read: if uyesi(kid) || superAdmin();
        allow create: if yazabilir(kid) && (kadmin(kid)
          || (kogretmen(kid) && request.resource.data.yayinlayanId == uid()));
        allow update, delete: if yazabilir(kid)
          && (kadmin(kid) || resource.data.yayinlayanId == uid());
      }

      // veli duyuru "okundu" durumu
      match /duyuruOkundu/{u} {
        allow read: if (uid() == u && uyesi(kid)) || superAdmin();
        allow write: if (uid() == u && uyesi(kid)) || superAdmin();
      }

      // -----------------------------------------------------
      //  mesajlar
      // -----------------------------------------------------
      match /mesajlar/{id} {
        allow read: if superAdmin() || (uyesi(kid) && uid() in resource.data.katilimcilar);
        allow create: if superAdmin() || (yazabilir(kid) && uyesi(kid)
          && request.resource.data.gonderenId == uid()
          && uid() in request.resource.data.katilimcilar
          && request.resource.data.katilimcilar.size() == 2);
        allow update: if uyesi(kid)
          && uid() in resource.data.katilimcilar
          && request.resource.data.katilimcilar == resource.data.katilimcilar
          && request.resource.data.gonderenId == resource.data.gonderenId;
        allow delete: if (superAdmin() || kadmin(kid));
      }

      // -----------------------------------------------------
      //  odemeler (aidat tahakkuku + veli "odedim" bildirimi)
      // -----------------------------------------------------
      match /odemeler/{id} {
        allow read: if superAdmin() || kadmin(kid)
          || (uyesi(kid) && resource.data.veliId == uid());
        allow create, delete: if (superAdmin() || kadmin(kid)) && yazabilir(kid);
        // Yonetici her alani gunceller; veli SADECE kendi kaydini
        // "bildirildi" durumuna cekip 'bildirim' alanini ekleyebilir.
        allow update: if ((superAdmin() || kadmin(kid)) && yazabilir(kid))
          || (uyesi(kid)
              && resource.data.veliId == uid()
              && request.resource.data.veliId == resource.data.veliId
              && request.resource.data.ogrenciId == resource.data.ogrenciId
              && request.resource.data.ay == resource.data.ay
              && request.resource.data.tutar == resource.data.tutar
              && request.resource.data.durum == 'bildirildi'
              && resource.data.durum != 'odendi');
      }

      // -----------------------------------------------------
      //  talepler (ogretmen -> yonetim istekleri)
      // -----------------------------------------------------
      match /talepler/{id} {
        allow read: if uyesi(kid) || superAdmin();
        allow create: if yazabilir(kid) && (kadmin(kid)
          || (kogretmen(kid) && request.resource.data.ogretmenId == uid()));
        // Yonetici durum/yanit gunceller; ogretmen yalnizca kendi 'yeni' talebini.
        allow update: if yazabilir(kid) && (kadmin(kid)
          || (kogretmen(kid) && resource.data.ogretmenId == uid()
              && resource.data.durum == 'yeni'));
        allow delete: if superAdmin() || kadmin(kid)
          || (kogretmen(kid) && resource.data.ogretmenId == uid());
      }

      // -----------------------------------------------------
      //  izinBelgeleri (gezi / izin / belge -> veli onayi)
      // -----------------------------------------------------
      match /izinBelgeleri/{id} {
        allow read: if uyesi(kid) || superAdmin();
        allow write: if (superAdmin() || kadmin(kid)) && yazabilir(kid);

        match /yanitlar/{u} {
          allow read: if uyesi(kid) || superAdmin();
          // Veli yalnizca BIR KEZ yanit verebilir; sonradan degistiremez/silemez.
          allow create: if uid() == u && uyesi(kid)
            && request.resource.data.karar in ['onay', 'ret'];
          allow update: if false;
          // Yeniden yanit gerekiyorsa yonetici/saglayici mevcut yaniti siler.
          allow delete: if superAdmin() || kadmin(kid);
        }
      }

      // -----------------------------------------------------
      //  fotograflar (uroturler Google Drive'da; burada ustveri)
      // -----------------------------------------------------
      match /fotograflar/{id} {
        allow read: if uyesi(kid) || superAdmin();
        allow create: if superAdmin() || (yazabilir(kid)
          && request.resource.data.yukleyenId == uid()
          && (kadmin(kid)
              || (kogretmen(kid)
                  && request.resource.data.hedef != 'okul'
                  && sinifOgretmeni(kid, request.resource.data.hedef))));
        allow update, delete: if superAdmin()
          || (yazabilir(kid) && (kadmin(kid) || resource.data.yukleyenId == uid()));
      }

      // -----------------------------------------------------
      //  aboneOdemeleri (saglayici tahsilat defteri)
      //  Sadece super-admin yazar; kres yoneticisi kendi gecmisini gorur.
      // -----------------------------------------------------
      match /aboneOdemeleri/{id} {
        allow read: if superAdmin() || kadmin(kid);
        allow write: if superAdmin();
      }

      // -----------------------------------------------------
      //  randevular (veli <-> personel: cocugun ogretmeni / yonetici)
      // -----------------------------------------------------
      match /randevular/{id} {
        allow read: if superAdmin() || kadmin(kid)
          || (uyesi(kid) && resource.data.personelUid == uid())
          || (uyesi(kid) && resource.data.veliUid == uid());
        allow create: if yazabilir(kid) && uyesi(kid)
          && request.resource.data.veliUid == uid()
          && ogrenciVelisi(kid, request.resource.data.ogrenciId)
          && request.resource.data.durum == 'bekliyor';
        // Personel/yonetici durum + not gunceller; veli kendi randevusunu duzenler/iptal eder.
        allow update: if yazabilir(kid) && (
          kadmin(kid)
          || (uyesi(kid) && resource.data.personelUid == uid())
          || (uyesi(kid) && resource.data.veliUid == uid()
              && request.resource.data.veliUid == resource.data.veliUid
              && request.resource.data.personelUid == resource.data.personelUid
              && request.resource.data.ogrenciId == resource.data.ogrenciId)
        );
        allow delete: if superAdmin() || kadmin(kid)
          || (uyesi(kid) && resource.data.veliUid == uid());
      }

      // -----------------------------------------------------
      //  kapiBildirimleri (Kurum Zili — "Geliyorum" / "Geldim")
      //  Dokuman kimligi: {ogrenciId}_{tarih}
      // -----------------------------------------------------
      match /kapiBildirimleri/{id} {
        allow read: if superAdmin() || kadmin(kid)
          || (kogretmen(kid) && sinifOgretmeni(kid, resource.data.sinifId))
          || (uyesi(kid) && resource.data.veliUid == uid());
        allow create, update: if yazabilir(kid) && uyesi(kid)
          && request.resource.data.veliUid == uid()
          && ogrenciVelisi(kid, request.resource.data.ogrenciId);
        allow delete: if superAdmin() || kadmin(kid);
      }

      // -----------------------------------------------------
      //  ilaclar (Medikal Takip — ilac tanimi)
      // -----------------------------------------------------
      match /ilaclar/{id} {
        allow read: if superAdmin() || kadmin(kid)
          || (kogretmen(kid) && sinifOgretmeni(kid, resource.data.sinifId))
          || ogrenciVelisi(kid, resource.data.ogrenciId);
        allow create, update: if yazabilir(kid) && (kadmin(kid)
          || (kogretmen(kid) && sinifOgretmeni(kid, request.resource.data.sinifId)));
        allow delete: if yazabilir(kid) && (kadmin(kid)
          || (kogretmen(kid) && sinifOgretmeni(kid, resource.data.sinifId)));
      }

      // -----------------------------------------------------
      //  ilacUygulamalari (doz uygulandi kaydi — degistirilemez)
      // -----------------------------------------------------
      match /ilacUygulamalari/{id} {
        allow read: if superAdmin() || kadmin(kid)
          || (kogretmen(kid) && sinifOgretmeni(kid, resource.data.sinifId))
          || ogrenciVelisi(kid, resource.data.ogrenciId);
        allow create: if yazabilir(kid)
          && request.resource.data.uygulayanUid == uid()
          && (kadmin(kid)
              || (kogretmen(kid) && sinifOgretmeni(kid, request.resource.data.sinifId)));
        allow update: if false;
        allow delete: if yazabilir(kid)
          && (kadmin(kid) || resource.data.uygulayanUid == uid());
      }

      // -----------------------------------------------------
      //  olcumler (Fiziksel Gelisim Takibi — boy / kilo)
      // -----------------------------------------------------
      match /olcumler/{id} {
        allow read: if superAdmin() || kadmin(kid)
          || (kogretmen(kid) && sinifOgretmeni(kid, resource.data.sinifId))
          || ogrenciVelisi(kid, resource.data.ogrenciId);
        allow create, update: if yazabilir(kid) && (kadmin(kid)
          || (kogretmen(kid) && sinifOgretmeni(kid, request.resource.data.sinifId)));
        allow delete: if yazabilir(kid) && (kadmin(kid)
          || (kogretmen(kid) && sinifOgretmeni(kid, resource.data.sinifId)));
      }

      // -----------------------------------------------------
      //  anketler (Geri Bildirim Modulu) + anketYanitlari
      // -----------------------------------------------------
      match /anketler/{id} {
        allow read: if uyesi(kid) || superAdmin();
        allow write: if (superAdmin() || kadmin(kid)) && yazabilir(kid);
      }
      match /anketYanitlari/{id} {
        allow read: if superAdmin() || kadmin(kid)
          || (uyesi(kid) && resource.data.yanitlayanUid == uid());
        allow create: if yazabilir(kid) && uyesi(kid)
          && request.resource.data.yanitlayanUid == uid();
        // 'onay' turu yanitlari degistirilemez; digerleri guncellenebilir.
        allow update: if yazabilir(kid) && uyesi(kid)
          && resource.data.yanitlayanUid == uid()
          && request.resource.data.yanitlayanUid == resource.data.yanitlayanUid
          && request.resource.data.anketId == resource.data.anketId
          && resource.data.tur != 'onay';
        allow delete: if superAdmin() || kadmin(kid);
      }

      // -----------------------------------------------------
      //  ajandaOgeleri (Ajanda Modulu — yonetici + ogretmen)
      // -----------------------------------------------------
      match /ajandaOgeleri/{id} {
        allow read: if superAdmin() || kadmin(kid) || kogretmen(kid);
        allow write: if (superAdmin() || kadmin(kid)) && yazabilir(kid);
      }

      // -----------------------------------------------------
      //  belgePaylasimlari (Ogrenciye ozel dokuman — Google Drive)
      // -----------------------------------------------------
      match /belgePaylasimlari/{id} {
        allow read: if superAdmin() || kadmin(kid)
          || (kogretmen(kid) && sinifOgretmeni(kid, resource.data.sinifId))
          || ogrenciVelisi(kid, resource.data.ogrenciId);
        allow create: if yazabilir(kid)
          && request.resource.data.yukleyenUid == uid()
          && (kadmin(kid)
              || (kogretmen(kid) && sinifOgretmeni(kid, request.resource.data.sinifId)));
        allow update, delete: if yazabilir(kid)
          && (kadmin(kid) || resource.data.yukleyenUid == uid());
      }

      // -----------------------------------------------------
      //  islemKayitlari (KVKK denetim gunlugu)
      // -----------------------------------------------------
      match /islemKayitlari/{id} {
        allow read: if superAdmin() || kadmin(kid);
        allow create: if superAdmin() || (uyesi(kid) && request.resource.data.kim == uid());
        allow update: if false;              // degistirilemez
        allow delete: if superAdmin();       // kres silme / KVKK imha
      }
    }
  }
}
